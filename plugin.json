{
  "id": "ethercat",
  "name": "EtherCAT",
  "description": "High-speed cyclic EtherCAT I/O for DARTWIC using a KickCAT C bridge.",
  "author": "Kempton Burton",
  "version": "2.0.0",
  "minEngineVersion": "2.0.0",
  "minInterfaceVersion": "2.0.0",
  "contains_engine_plugin": true,
  "contains_interface_plugin": true,
  "device_discovery": {
    "enabled": true,
    "scan_interval_seconds": 5,
    "receive_timeout_us": 100000,
    "cycle_receive_timeout_us": 100000,
    "create_cycle_task": true,
    "maximum_suggested_channels": 512
  }
}
